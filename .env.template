# reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
# Site key is public; secret must stay server-only. Contact form fails closed without both.
# DO NOT commit the actual secret to version control
NEXT_PUBLIC_RECAPTCHA_SITEKEY=your_recaptcha_site_key_here
RECAPTCHA_SECRETKEY=your_recaptcha_secret_key_here

# EmailJS private key (Account > Security). Used only by /api/contact over HTTPS.
# Template must include {{from_name}} {{from_email}} {{reply_to}} {{hire_me}} {{message}}
# EMAILJS_PRIVATE_KEY=

# Optional absolute site URL for canonicals, Open Graph, and sitemap
NEXT_PUBLIC_SITE_URL=https://aspauldingcode.com

# Optional: YouTube Data API key for subscriber/video counts on channel previews
YOUTUBE_API_KEY=

# Optional: GitHub token for higher rate limits on profile JSON / portfolio-agent
# GITHUB_TOKEN=

# Portfolio agent LLM (pick one; used by scripts/portfolio-agent/propose.mjs)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# LLM_PROVIDER=groq

# Optional CDN base for immutable image assets (e.g. https://cdn.example.com/aspauldingcode)
# Leave empty to use local /public images in development.
NEXT_PUBLIC_IMAGE_CDN_BASE=