---
export const prerender = true;

import workSheet from '@/styles/work.css?url';
import WhispererPrivacyPolicy from '@/components/WhispererPrivacy';
import Base from '@/layouts/Base.astro';

const seo = {
  title: 'Whisperer Privacy Policy',
  description:
    'Privacy Policy for Whisperer, the voice ChatGPT client for Apple Watch and iPhone by Alex Spaulding.',
  canonicalPath: '/whisperer/privacy',
  ogType: 'article',
};
---

<Base seo={seo} sheets={[workSheet]}>
  <WhispererPrivacyPolicy />
</Base>
