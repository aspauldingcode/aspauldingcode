{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "aspauldingcode.com" }],
      "destination": "https://www.aspauldingcode.com/:path*",
      "permanent": true
    },
    {
      "source": "/projects/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
